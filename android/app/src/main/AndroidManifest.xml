<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the AnkiDroid ContentProvider (SCHEMA.md §7). -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Android 11+ package visibility: AnkiDroid + Garmin Connect Mobile. -->
    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Garmanki.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
